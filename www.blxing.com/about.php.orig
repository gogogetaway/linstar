@keyframes pulse2 {
  0% {
    transform: scale(1); /* 初始状态，无放大 */
  }
  50% {
    transform: scale(1.5); /* 中间状态，放大到1.5倍 */
  }
  100% {
    transform: scale(1); /* 结束状态，恢复原状 */
  }
}
