<script>
function zhanshia(a,c){

var div = document.querySelector('div[name=lefta'+a+']');
if(div.style.display=="none"){
div.style.display ="";
c.innerHTML="--";
}
else
{
div.style.display ="none";
c.innerHTML="+";
}

}

function xssearch(){
$("#divsearch").fadeIn();
}

function showmenu(){

$("#menua").fadeIn();
$("#menu").fadeIn();
$("#navicon").attr("src", "img/navdha.gif");
}
function hidmenu(){
$("#menua").fadeOut();
$("#menu").fadeOut();
$("#navicon").attr("src", "img/navdh.gif");
}

function xianshi(a){
if(document.getElementById(a+"nav").innerText=="+"){document.getElementById(a+"nav").innerText="-";}
else{document.getElementById(a+"nav").innerText="+";}

$("#"+a).slideToggle();



}
</script>
